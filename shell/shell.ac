U0 shell_cmd_dumpsec(PU8 args) {
    args = str_trim(args);
    if (strlen(args) == 0) {
        g_sh_fg_color = LIGHT_RED;
        shell_puts((PU8)"Usage: dumpsec <drive_name> <lba_sector>\nExample: dumpsec hd0 0\n");
        g_sh_fg_color = WHITE;
        return;
    }
    PU8 space = strchr(args, ' ');
    if (space == NULLPTR) {
        g_sh_fg_color = LIGHT_RED;
        shell_puts((PU8)"Usage: dumpsec <drive_name> <lba_sector>\n");
        g_sh_fg_color = WHITE;
        return;
    }
    *space = 0;
    PU8 dev = args;
    U32 lba = (U32)atoi(space + 1);
    dump_sector(dev, lba);
}

U0 shell_cmd_memdump(PU8 args) {
    args = str_trim(args);
    if (strlen(args) == 0) {
        g_sh_fg_color = LIGHT_RED;
        shell_puts((PU8)"Usage: memdump <address_hex> <bytes_to_dump>\nExample: memdump 0x10000 64\n");
        g_sh_fg_color = WHITE;
        return;
    }
    PU8 space = strchr(args, ' ');
    if (space == NULLPTR) {
        g_sh_fg_color = LIGHT_RED;
        shell_puts((PU8)"Usage: memdump <address_hex> <bytes_to_dump>\nExample: memdump 0x10000 64\n");
        g_sh_fg_color = WHITE;
        return;
    }
    *space = 0;
    PU8 addr_str = str_trim(args);
    PU8 count_str = str_trim(space + 1);

    U32 addr = atou_hex(addr_str);
    U32 count = atou(count_str);

    if (count == 0) {
        g_sh_fg_color = LIGHT_RED;
        shell_puts((PU8)"Error: Invalid or zero byte count specified.\n");
        g_sh_fg_color = WHITE;
        return;
    }

    g_sh_fg_color = LIGHT_CYAN;
    shell_printf("=== Memory Dump [0x%08X - 0x%08X] (%u bytes) ===\n", addr, addr + count, count);
    g_sh_fg_color = WHITE;

    PU8 ptr = (PU8)addr;
    for (U32 i = 0; i < count; i = i + 16) {
        shell_printf("0x%08X: ", addr + i);
        for (U32 j = 0; j < 16; j = j + 1) {
            if (i + j < count) {
                shell_printf("%02X ", ptr[i + j]);
            } else {
                shell_puts((PU8)"   ");
            }
        }
        shell_puts((PU8)"  | ");
        for (U32 j = 0; j < 16; j = j + 1) {
            if (i + j < count) {
                U8 c = ptr[i + j];
                if (c >= 32 && c <= 126) {
                    shell_printf("%c", c);
                } else {
                    shell_puts((PU8)".");
                }
            } else {
                shell_puts((PU8)" ");
            }
        }
        shell_puts((PU8)" |\n");
    }
}

