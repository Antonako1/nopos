#ifndef SHELL_AC
#define SHELL_AC

// Global shell state
U32 g_sh_cx;            // Current cursor X (pixel offset)
U32 g_sh_cy;            // Current cursor Y (pixel offset)
U8  g_sh_fg_color;      // Foreground color index
U8  g_sh_bg_color;      // Background color index

#define SHELL_HIST_MAX 16
#define SHELL_LINE_MAX 128

U8  g_sh_history[SHELL_HIST_MAX][SHELL_LINE_MAX];
U32 g_sh_hist_count;
I32 g_sh_hist_index;
U8  g_sh_saved_line[SHELL_LINE_MAX];

// ---------------------------------------------------------------------------
// Framebuffer Scrolling
U0 sh_scroll() {
    U32 stride = gkt->vbe_mode_info.BytesPerScanLine;
    U32 y_res   = gkt->vbe_mode_info.YResolution;
    PU8 fb = (PU8)gkt->vbe_mode_info.PhysBasePtr;

    U32 line_bytes = 16 * stride;
    U32 total_bytes = y_res * stride;
    U32 copy_bytes = total_bytes - line_bytes;

    memmove(fb, fb + line_bytes, copy_bytes);
    memset(fb + copy_bytes, BLACK, line_bytes);

    if (g_sh_cy >= 16) {
        g_sh_cy = g_sh_cy - 16;
    } else {
        g_sh_cy = 0;
    }
}

// ---------------------------------------------------------------------------
// Low-level Character Output
U0 shell_putc(U8 c) {
    serial_wb(SERIAL_PORT2, c);
    U32 x_res = gkt->vbe_mode_info.XResolution;
    U32 y_res = gkt->vbe_mode_info.YResolution;

    if (c == '\n') {
        g_sh_cx = 0;
        g_sh_cy = g_sh_cy + 16;
        if (g_sh_cy >= y_res - 16) {
            sh_scroll();
        }
        return;
    }
    if (c == '\r') {
        g_sh_cx = 0;
        return;
    }
    if (c == 0x08) {
        if (g_sh_cx >= 8) {
            g_sh_cx = g_sh_cx - 8;
            SVGA_DRAW_CHARACTER(g_sh_cx, g_sh_cy, ' ', g_sh_fg_color, g_sh_bg_color);
        }
        return;
    }

    SVGA_DRAW_CHARACTER(g_sh_cx, g_sh_cy, c, g_sh_fg_color, g_sh_bg_color);
    g_sh_cx = g_sh_cx + 8;
    if (g_sh_cx >= x_res) {
        g_sh_cx = 0;
        g_sh_cy = g_sh_cy + 16;
        if (g_sh_cy >= y_res - 16) {
            sh_scroll();
        }
    }
}

U0 shell_puts(PU8 s) {
    while (*s != 0) {
        shell_putc(*s);
        s = s + 1;
    }
}

static U0 screen_putch(U8 c, VOID *ctx) {
    (VOID)ctx;
    shell_putc(c);
}

U0 shell_printf(PU8 fmt, ...) {
    va_list args;
    va_start(args, fmt);
    vformat((VOIDPTR)screen_putch, NULLPTR, fmt, args);
    va_end(args);
}

// ---------------------------------------------------------------------------
// History Helpers
U0 shell_hist_add(PU8 line) {
    if (strlen(line) == 0) return;
    if (g_sh_hist_count > 0) {
        if (strcmp((PU8)g_sh_history[g_sh_hist_count - 1], line) == 0) return;
    }
    if (g_sh_hist_count < SHELL_HIST_MAX) {
        strcpy((PU8)g_sh_history[g_sh_hist_count], line);
        g_sh_hist_count = g_sh_hist_count + 1;
    } else {
        for (U32 i = 0; i < SHELL_HIST_MAX - 1; i = i + 1) {
            strcpy((PU8)g_sh_history[i], (PU8)g_sh_history[i + 1]);
        }
        strcpy((PU8)g_sh_history[SHELL_HIST_MAX - 1], line);
    }
}

// ---------------------------------------------------------------------------
// Path Resolution
#define SHELL_PATH_DEPTH 16

U0 shell_resolve_path(PU8 arg, PU8 out_path) {
    if (arg == NULLPTR || strlen(arg) == 0) {
        strcpy(out_path, g_sh_cwd);
        return;
    }

    U8 drive[16];
    drive[0] = 0;
    PU8 rel = arg;

    if ((arg[0] >= 'a' && arg[0] <= 'z') || (arg[0] >= 'A' && arg[0] <= 'Z')) {
        if (arg[1] == ':') {
            drive[0] = c_toupper(arg[0]);
            drive[1] = ':';
            drive[2] = '/';
            drive[3] = 0;
            rel = arg + 2;
            if (*rel == '/' || *rel == '\\') {
                rel = rel + 1;
            }
        }
    }

    if (drive[0] == 0) {
        if (strncmp(arg, "ram0:", 5) == 0) {
            strcpy(drive, "ram0:/");
            rel = arg + 5;
            if (*rel == '/' || *rel == '\\') rel = rel + 1;
        } else if (strncmp(arg, "hd0p1:", 6) == 0) {
            strcpy(drive, "hd0p1:/");
            rel = arg + 6;
            if (*rel == '/' || *rel == '\\') rel = rel + 1;
        }
    }

    U8 full_path[128];
    if (drive[0] != 0) {
        strcpy(full_path, rel);
    } else {
        PU8 colon = strchr(g_sh_cwd, ':');
        if (colon != NULLPTR) {
            U32 dlen = (U32)(colon - g_sh_cwd + 1);
            strncpy(drive, g_sh_cwd, dlen);
            drive[dlen] = '/';
            drive[dlen + 1] = 0;
        } else {
            strcpy(drive, "A:/");
        }

        if (arg[0] == '/' || arg[0] == '\\') {
            strcpy(full_path, arg + 1);
        } else {
            PU8 cwd_rest = g_sh_cwd;
            PU8 c_pos = strchr(g_sh_cwd, ':');
            if (c_pos != NULLPTR) {
                cwd_rest = c_pos + 1;
                if (*cwd_rest == '/' || *cwd_rest == '\\') cwd_rest = cwd_rest + 1;
            }
            strcpy(full_path, cwd_rest);
            U32 flen = strlen(full_path);
            if (flen > 0 && full_path[flen - 1] != '/' && full_path[flen - 1] != '\\') {
                strcat(full_path, "/");
            }
            strcat(full_path, arg);
        }
    }

    for (U32 i = 0; full_path[i] != 0; i = i + 1) {
        if (full_path[i] == '\\') {
            full_path[i] = '/';
        }
    }

    U8 components[SHELL_PATH_DEPTH][32];
    U32 depth = 0;

    PU8 p = full_path;
    while (*p != 0) {
        while (*p == '/') p = p + 1;
        if (*p == 0) break;

        PU8 slash = strchr(p, '/');
        U8 comp[32];
        if (slash != NULLPTR) {
            U32 clen = (U32)(slash - p);
            if (clen >= 32) clen = 31;
            strncpy(comp, p, clen);
            comp[clen] = 0;
            p = slash + 1;
        } else {
            strncpy(comp, p, 31);
            comp[31] = 0;
            p = p + strlen(p);
        }

        if (strcmp(comp, ".") == 0 || strlen(comp) == 0) {
            continue;
        }
        if (strcmp(comp, "..") == 0) {
            if (depth > 0) {
                depth = depth - 1;
            }
            continue;
        }

        if (depth < SHELL_PATH_DEPTH) {
            strcpy((PU8)components[depth], comp);
            depth = depth + 1;
        }
    }

    strcpy(out_path, drive);
    for (U32 i = 0; i < depth; i = i + 1) {
        if (i > 0) {
            strcat(out_path, "/");
        }
        strcat(out_path, (PU8)components[i]);
    }
}

// ---------------------------------------------------------------------------
// Command Implementations
U0 shell_cmd_dir(PU8 args) {
    U8 target_path[128];
    args = str_trim(args);
    if (strlen(args) == 0) {
        strcpy(target_path, g_sh_cwd);
    } else {
        shell_resolve_path(args, target_path);
    }

    VFS_NODE dir_node;
    if (!vfs_open(target_path, &dir_node)) {
        g_sh_fg_color = LIGHT_RED;
        shell_printf("Directory or drive not found: %s\n", target_path);
        g_sh_fg_color = WHITE;
        return;
    }

    if (dir_node.type != VFS_TYPE_DIR) {
        g_sh_fg_color = LIGHT_RED;
        shell_printf("Not a directory: %s\n", target_path);
        g_sh_fg_color = WHITE;
        return;
    }

    g_sh_fg_color = YELLOW;
    shell_printf(" Directory of %s\n\n", target_path);
    g_sh_fg_color = WHITE;

    VFS_DIR_ENTRY entry;
    U32 idx = 0;
    U32 file_count = 0;
    U32 total_bytes = 0;

    while (vfs_readdir(&dir_node, idx, &entry)) {
        if (entry.is_directory) {
            shell_printf("  %-16s <DIR>        %u bytes\n", entry.name, entry.size);
        } else {
            shell_printf("  %-16s              %u bytes\n", entry.name, entry.size);
        }
        file_count = file_count + 1;
        total_bytes = total_bytes + entry.size;
        idx = idx + 1;
    }

    g_sh_fg_color = LIGHT_GRAY;
    shell_printf("\n  %u File(s)/Dir(s)    %u bytes total\n", file_count, total_bytes);
    g_sh_fg_color = WHITE;
}

U0 shell_cmd_type(PU8 args) {
    args = str_trim(args);
    if (strlen(args) == 0) {
        g_sh_fg_color = LIGHT_RED;
        shell_puts((PU8)"Error: missing filename.\nUsage: type <filename>\n");
        g_sh_fg_color = WHITE;
        return;
    }

    U8 target_path[128];
    shell_resolve_path(args, target_path);

    VFS_NODE node;
    if (!vfs_open(target_path, &node)) {
        g_sh_fg_color = LIGHT_RED;
        shell_printf("File not found: %s\n", target_path);
        g_sh_fg_color = WHITE;
        return;
    }

    if (node.size == 0) {
        shell_puts((PU8)"(File is empty)\n");
        return;
    }

    PU8 file_buf = (PU8)kmalloc(node.size + 1);
    if (file_buf == NULLPTR) {
        g_sh_fg_color = LIGHT_RED;
        shell_puts((PU8)"Error: insufficient memory to load file.\n");
        g_sh_fg_color = WHITE;
        return;
    }

    vfs_read(&node, 0, node.size, file_buf);
    file_buf[node.size] = 0;

    shell_puts(file_buf);
    if (file_buf[node.size - 1] != '\n') {
        shell_putc('\n');
    }

    kfree(file_buf);
}

U0 shell_cmd_cd(PU8 args) {
    args = str_trim(args);
    if (strlen(args) == 0) {
        shell_printf("Current directory: %s\n", g_sh_cwd);
        return;
    }

    U8 target_path[128];
    shell_resolve_path(args, target_path);

    VFS_NODE node;
    if (vfs_open(target_path, &node)) {
        if (node.type != VFS_TYPE_DIR) {
            g_sh_fg_color = LIGHT_RED;
            shell_printf("Not a directory: %s\n", args);
            g_sh_fg_color = WHITE;
            return;
        }
        strcpy(g_sh_cwd, target_path);
        U32 len = strlen(g_sh_cwd);
        if (len > 0 && g_sh_cwd[len - 1] != '/') {
            g_sh_cwd[len] = '/';
            g_sh_cwd[len + 1] = 0;
        }
    } else {
        g_sh_fg_color = LIGHT_RED;
        shell_printf("Invalid drive or path: %s\n", args);
        g_sh_fg_color = WHITE;
    }
}

U0 shell_cmd_touch(PU8 args) {
    args = str_trim(args);
    if (strlen(args) == 0) {
        g_sh_fg_color = LIGHT_RED;
        shell_puts((PU8)"Usage: touch <filename>\n");
        g_sh_fg_color = WHITE;
        return;
    }
    U8 target_path[128];
    shell_resolve_path(args, target_path);

    if (vfs_touch(target_path)) {
        shell_printf("Created file: %s\n", target_path);
    } else {
        g_sh_fg_color = LIGHT_RED;
        shell_printf("Failed to create file: %s\n", target_path);
        g_sh_fg_color = WHITE;
    }
}

