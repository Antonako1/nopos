// ---------------------------------------------------------------------------
// Command Dispatcher
U0 shell_exec(PU8 line) {
    line = str_trim(line);
    if (strlen(line) == 0) return;

    shell_hist_add(line);

    PU8 space = strchr(line, ' ');
    PU8 cmd = line;
    PU8 args = (PU8)"";

    if (space != NULLPTR) {
        *space = 0;
        args = space + 1;
    }

    if (stricmp(cmd, (PU8)"help") == 0 || strcmp(cmd, (PU8)"?") == 0) {
        shell_cmd_help();
    } else if (stricmp(cmd, (PU8)"drives") == 0 || stricmp(cmd, (PU8)"lsdev") == 0) {
        shell_cmd_drives();
    } else if (stricmp(cmd, (PU8)"install") == 0) {
        shell_cmd_install(args);
    } else if (stricmp(cmd, (PU8)"dumpsec") == 0) {
        shell_cmd_dumpsec(args);
    } else if (stricmp(cmd, (PU8)"memdump") == 0 || stricmp(cmd, (PU8)"mdump") == 0) {
        shell_cmd_memdump(args);
    } else if (stricmp(cmd, (PU8)"dir") == 0 || stricmp(cmd, (PU8)"ls") == 0) {
        shell_cmd_dir(args);
    } else if (stricmp(cmd, (PU8)"type") == 0 || stricmp(cmd, (PU8)"cat") == 0) {
        shell_cmd_type(args);
    } else if (stricmp(cmd, (PU8)"cd") == 0 || stricmp(cmd, (PU8)"chdir") == 0) {
        shell_cmd_cd(args);
    } else if (stricmp(cmd, (PU8)"touch") == 0 || stricmp(cmd, (PU8)"create") == 0) {
        shell_cmd_touch(args);
    } else if (stricmp(cmd, (PU8)"mkdir") == 0 || stricmp(cmd, (PU8)"md") == 0) {
        shell_cmd_mkdir(args);
    } else if (stricmp(cmd, (PU8)"rmdir") == 0 || stricmp(cmd, (PU8)"rd") == 0 ||
               stricmp(cmd, (PU8)"rm") == 0 || stricmp(cmd, (PU8)"del") == 0) {
        shell_cmd_rm(args);
    } else if (stricmp(cmd, (PU8)"A:") == 0 || stricmp(cmd, (PU8)"A:/") == 0 || stricmp(cmd, (PU8)"ram0:") == 0 || stricmp(cmd, (PU8)"ram0:/") == 0) {
        strcpy(g_sh_cwd, "A:/");
    } else if (stricmp(cmd, (PU8)"C:") == 0 || stricmp(cmd, (PU8)"C:/") == 0 || stricmp(cmd, (PU8)"hd0p1:") == 0 || stricmp(cmd, (PU8)"hd0p1:/") == 0) {
        strcpy(g_sh_cwd, "C:/");
    } else if (stricmp(cmd, (PU8)"echo") == 0) {
        shell_cmd_echo(args);
    } else if (stricmp(cmd, (PU8)"dcomputs") == 0) {
        shell_cmd_dcomputs(args);
    } else if (stricmp(cmd, (PU8)"clear") == 0 || stricmp(cmd, (PU8)"cls") == 0) {
        shell_cmd_clear();
    } else if (stricmp(cmd, (PU8)"mem") == 0 || stricmp(cmd, (PU8)"pmm") == 0) {
        shell_cmd_mem();
    } else if (stricmp(cmd, (PU8)"vesa") == 0 || stricmp(cmd, (PU8)"info") == 0) {
        shell_cmd_vesa();
    } else if (stricmp(cmd, (PU8)"history") == 0) {
        shell_cmd_history();
    } else if (stricmp(cmd, (PU8)"reboot") == 0) {
        shell_cmd_reboot();
    } else if (stricmp(cmd, (PU8)"panic") == 0) {
        shell_cmd_panic();
    } else {
        g_sh_fg_color = LIGHT_RED;
        shell_printf("Unknown command: '%s'. Type 'help' for commands.\n", cmd);
        g_sh_fg_color = WHITE;
    }
}

// ---------------------------------------------------------------------------
// Prompt & Interactive Shell Loop
U0 shell_print_prompt() {
    g_sh_fg_color = LIGHT_GREEN;
    shell_printf("%s# ", g_sh_cwd);
    g_sh_fg_color = WHITE;
}

U0 SHELL_INIT() {
    g_sh_cx = 0;
    g_sh_cy = 0;
    g_sh_fg_color = WHITE;
    g_sh_bg_color = BLACK;
    g_sh_hist_count = 0;
    g_sh_hist_index = -1;

    SVGA_CLEAR_SCREEN(BLACK);

    g_sh_fg_color = LIGHT_GREEN;
    shell_puts((PU8)"=====================================================\n");
    shell_puts((PU8)"              Welcome to NopOS Shell                 \n");
    shell_puts((PU8)"=====================================================\n");
    g_sh_fg_color = WHITE;
    shell_puts((PU8)"Type 'help' to view available system commands.\n\n");

    shell_print_prompt();
}

U0 SHELL_RUN() {
    SHELL_INIT();

    U8 line_buf[SHELL_LINE_MAX];
    memzero(line_buf, SHELL_LINE_MAX);
    U32 len = 0;

    while (1) {
        while (!ps2_key_ready()) {}
        U8 key = ps2_getc();
        U8 mods = ps2_get_mods();
        if (key == 0) continue;

        U8 has_ctrl = (mods & (KBD_MOD_LCTRL | KBD_MOD_RCTRL)) ? 1 : 0;
        U8 has_alt  = (mods & (KBD_MOD_LALT  | KBD_MOD_RALT))  ? 1 : 0;
        if (has_ctrl && has_alt && key == KBD_DEL) {
            shell_cmd_reboot();
        }
        // --- Arrow Up: History Previous ---
        if (key == KBD_UP) {
            if (g_sh_hist_count == 0) continue;
            if (g_sh_hist_index == -1) {
                // Save current typed buffer
                line_buf[len] = 0;
                strcpy((PU8)g_sh_saved_line, line_buf);
                g_sh_hist_index = (I32)g_sh_hist_count - 1;
            } else if (g_sh_hist_index > 0) {
                g_sh_hist_index = g_sh_hist_index - 1;
            } else {
                continue; // Already at oldest
            }

            // Erase current on-screen line
            while (len > 0) {
                shell_putc(0x08);
                len = len - 1;
            }
            strcpy(line_buf, (PU8)g_sh_history[g_sh_hist_index]);
            len = strlen(line_buf);
            shell_puts(line_buf);
            continue;
        }

        // --- Arrow Down: History Next ---
        if (key == KBD_DOWN) {
            if (g_sh_hist_index == -1) continue;

            if (g_sh_hist_index < (I32)g_sh_hist_count - 1) {
                g_sh_hist_index = g_sh_hist_index + 1;
                while (len > 0) {
                    shell_putc(0x08);
                    len = len - 1;
                }
                strcpy(line_buf, (PU8)g_sh_history[g_sh_hist_index]);
                len = strlen(line_buf);
                shell_puts(line_buf);
            } else {
                // Restore original saved line
                g_sh_hist_index = -1;
                while (len > 0) {
                    shell_putc(0x08);
                    len = len - 1;
                }
                strcpy(line_buf, (PU8)g_sh_saved_line);
                len = strlen(line_buf);
                shell_puts(line_buf);
            }
            continue;
        }

        // --- Backspace ---
        if (key == 0x08) {
            if (len > 0) {
                len = len - 1;
                line_buf[len] = 0;
                shell_putc(0x08);
            }
            continue;
        }

        // --- Enter ---
        if (key == '\n' || key == '\r') {
            shell_putc('\n');
            line_buf[len] = 0;
            shell_exec(line_buf);
            memzero(line_buf, SHELL_LINE_MAX);
            len = 0;
            g_sh_hist_index = -1;
            shell_print_prompt();
            continue;
        }

        // --- Ignore other special keys (F1-F12, Left, Right, etc.) ---
        if (key >= 0x80) continue;

        // --- Printable Character ---
        if (len < SHELL_LINE_MAX - 1) {
            line_buf[len] = key;
            len = len + 1;
            line_buf[len] = 0;
            shell_putc(key);
        }
    }
}

#endif // SHELL_AC
