#define PIT_CHNL0       0x40
#define PIT_CMD         0x43
#define PIT_FREQ        1193182

// irq(0)
#define PIT_VECTOR      0x20 
#define PIT_TICK_HZ     100
#define PIT_TICK_MS     (1000 / PIT_TICK_HZ)


U32 g_pit_ticks = 0;
U32 g_pit_hz = 0;

void pit_set_freq(U32 freq) {
    U32 div = PIT_FREQ / freq;
    outb(PIT_CMD, 0x36);
    outb(PIT_CHNL0, (U8)(div & 0xFF));
    outb(PIT_CHNL0, (U8)((div >> 8) & 0xFF));
}

void pit_init() {
    g_pit_hz = PIT_TICK_HZ;
    pit_set_freq(g_pit_hz);

    // asm {
    //     MOV AL, 0xFD
    //     OUT 0x21, AL
    // }
    pic_unmask(0);
    g_pit_ticks = 0;
}
U0 pit_handler() {
    g_pit_ticks++;
}
