#define PCI_SUBCLASS_SSA             0x02
#define PCI_SUBCLASS_USB             0x03
#define PCI_SUBCLASS_FIBRE_CHANNEL   0x04
#define PCI_SUBCLASS_SMBUS           0x05
#define PCI_SUBCLASS_INFINIBAND      0x06
#define PCI_SUBCLASS_IPMI            0x07
#define PCI_SUBCLASS_SERCOS          0x08
#define PCI_SUBCLASS_CAN             0x09
#define PCI_SUBCLASS_OTHER_SERIAL    0x80


#define PCI_CLASS_SERIAL_BUS    0x0C
#define PCI_SUBCLASS_USB        0x03
#define PCI_SUBCLASS_SMBUS      0x05



#define PCI_HEADER_TYPE_OFFSET       0x0E
#define PCI_CLASS_CODE_OFFSET        0x0B
#define PCI_SUBCLASS_OFFSET          0x0A
#define PCI_PROG_IF_OFFSET           0x09
#define PCI_REVISION_ID_OFFSET       0x08
#define PCI_VENDOR_ID_OFFSET         0x00
#define PCI_DEVICE_ID_OFFSET         0x02
#define PCI_INTERRUPT_LINE_OFFSET    0x3C
#define PCI_INTERRUPT_PIN_OFFSET     0x3D
#define PCI_STATUS_OFFSET            0x06
#define PCI_COMMAND_OFFSET           0x04
#define PCI_CAPABILITIES_POINTER     0x34
#define PCI_SECONDARY_BUS_OFFSET     0x19
#define PCI_SUBSYSTEM_VENDOR_ID_OFFSET 0x2C
#define PCI_SUBSYSTEM_ID_OFFSET       0x2E

// PCI Configuration Space Offsets
typedef struct _pci_type0_header_t {
    U16 vendor_id;      // 0x00
    U16 device_id;      // 0x02
    U16 command;        // 0x04
    U16 status;         // 0x06
    U8 revision_id;     // 0x08
    U8 prog_if;         // 0x09
    U8 subclass;        // 0x0A
    U8 class_code;      // 0x0B
    U8 cache_line_size; // 0x0C
    U8 latency_timer;   // 0x0D
    U8 header_type;     // 0x0E
    U8 bist;            // 0x0F
    U32 bar0;           // 0x10
    U32 bar1;           // 0x14
    U32 bar2;           // 0x18
    U32 bar3;           // 0x1C
    U32 bar4;           // 0x20
    U32 bar5;           // 0x24
    U32 cardbus_cis_pointer; // 0x28 (optional)
    U16 subsystem_vendor_id; // 0x2C
    U16 subsystem_id;        // 0x2E
    U32 expansion_rom_base;  // 0x30
    U8 capabilities_pointer; // 0x34
    U8 reserved1[7];         // 0x35–0x3B
    U8 interrupt_line;       // 0x3C
    U8 interrupt_pin;        // 0x3D
    U8 min_grant;            // 0x3E
    U8 max_latency;          // 0x3F
} pci_type0_header_t;

typedef struct _pci_device_entry_t {
    U8 bus;
    U8 slot;
    U8 func;
    pci_type0_header_t header;
} pci_device_entry_t;

#define PCI_COMMAND_IO  (1 << 0)
#define PCI_COMMAND_BUSMASTER (1 << 2)


pci_device_entry_t pci_devices[PCI_MAX_DEVICES];
U32 pci_device_count = 0;


U32 pci_read_config_dword(U8 bus, U8 slot, U8 func, U8 offset) {
    U32 address = 0x80000000 | ((U32)bus << 16) | ((U32)slot << 11) | ((U32)func << 8) | ((U32)offset & 0xFC);
    outl(PCI_CONFIG_ADDRESS, address);
    return inl(PCI_CONFIG_DATA);
}

U0 pci_write_config_dword(U8 bus, U8 slot, U8 func, U8 offset, U32 val) {
    U32 address = 0x80000000 | ((U32)bus << 16) | ((U32)slot << 11) | ((U32)func << 8) | ((U32)offset & 0xFC);
    outl(PCI_CONFIG_ADDRESS, address);
    outl(PCI_CONFIG_DATA, val);
}

U16 pci_read_config_word(U8 bus, U8 slot, U8 func, U8 offset) {
    U32 dword = pci_read_config_dword(bus, slot, func, offset);
    return (U16)((dword >> ((offset & 2) * 8)) & 0xFFFF);
}

U0 pci_write_config_word(U8 bus, U8 slot, U8 func, U8 offset, U16 val) {
    U32 dword = pci_read_config_dword(bus, slot, func, offset);
    U32 shift = (offset & 2) * 8;
    U32 mask = ~(0xFFFF << shift);
    U32 new_dword = (dword & mask) | ((U32)val << shift);
    pci_write_config_dword(bus, slot, func, offset, new_dword);
}

U8 pci_read_config_byte(U8 bus, U8 slot, U8 func, U8 offset) {
    U32 dword = pci_read_config_dword(bus, slot, func, offset);
    return (U8)((dword >> ((offset & 3) * 8)) & 0xFF);
}

BOOL pci_enable_bus_mastering(U8 bus, U8 slot, U8 func) {
    U16 cmd = pci_get_command(bus, slot, func);
    cmd |= (PCI_COMMAND_IO | PCI_COMMAND_BUSMASTER);
    pci_write_config_word(bus, slot, func, PCI_COMMAND_OFFSET, cmd);

    cmd = pci_get_command(bus, slot, func);
    return (cmd & 0x04) != 0;
}

U8 pci_get_header_type(U8 bus, U8 slot, U8 func) {
    return pci_read_config_byte(bus, slot, func, PCI_HEADER_TYPE_OFFSET);
}
U8 pci_get_class(U8 bus, U8 slot, U8 func) {
    return pci_read_config_byte(bus, slot, func, PCI_CLASS_CODE_OFFSET);
}
U8 pci_get_subclass(U8 bus, U8 slot, U8 func) {
    return pci_read_config_byte(bus, slot, func, PCI_SUBCLASS_OFFSET);
}
U8 pci_get_prog_if(U8 bus, U8 slot, U8 func) {
    return pci_read_config_byte(bus, slot, func, PCI_PROG_IF_OFFSET);
}
U8 pci_get_secondary_bus(U8 bus, U8 slot, U8 func) {
    return pci_read_config_byte(bus, slot, func, PCI_SECONDARY_BUS_OFFSET);
}
U16 pci_get_vendor_id(U8 bus, U8 slot, U8 func) {
    return pci_read_config_word(bus, slot, func, PCI_VENDOR_ID_OFFSET);
}
U16 pci_get_device_id(U8 bus, U8 slot, U8 func) {
    return pci_read_config_word(bus, slot, func, PCI_DEVICE_ID_OFFSET);
}
U32 pci_get_bar(U8 bus, U8 slot, U8 func, U8 bar_num) {
    if(bar_num > 5) return 0;
    return pci_read_config_dword(bus, slot, func, 0x10 + (bar_num * 4));
}

U32 pci_get_bar0(U8 bus, U8 slot, U8 func) { return pci_get_bar(bus, slot, func, 0); }
U32 pci_get_bar1(U8 bus, U8 slot, U8 func) { return pci_get_bar(bus, slot, func, 1); }
U32 pci_get_bar2(U8 bus, U8 slot, U8 func) { return pci_get_bar(bus, slot, func, 2); }
U32 pci_get_bar3(U8 bus, U8 slot, U8 func) { return pci_get_bar(bus, slot, func, 3); }
U32 pci_get_bar4(U8 bus, U8 slot, U8 func) { return pci_get_bar(bus, slot, func, 4); }
U32 pci_get_bar5(U8 bus, U8 slot, U8 func) { return pci_get_bar(bus, slot, func, 5); }

U32 pci_get_interrupt_line(U8 bus, U8 slot, U8 func) {
    return pci_read_config_byte(bus, slot, func, PCI_INTERRUPT_LINE_OFFSET);
}
U32 pci_get_interrupt_pin(U8 bus, U8 slot, U8 func) {
    return pci_read_config_byte(bus, slot, func, PCI_INTERRUPT_PIN_OFFSET);
}
U32 pci_get_status(U8 bus, U8 slot, U8 func) {
    return pci_read_config_word(bus, slot, func, PCI_STATUS_OFFSET);
}
U32 pci_get_command(U8 bus, U8 slot, U8 func) {
    return pci_read_config_word(bus, slot, func, PCI_COMMAND_OFFSET);
}
U32 pci_get_capabilities_pointer(U8 bus, U8 slot, U8 func) {
    return pci_read_config_byte(bus, slot, func, PCI_CAPABILITIES_POINTER);
}
U16 pci_get_subsystem_vendor_id(U8 bus, U8 slot, U8 func) {
    return pci_read_config_word(bus, slot, func, PCI_SUBSYSTEM_VENDOR_ID_OFFSET);
}
U16 pci_get_subsystem_id(U8 bus, U8 slot, U8 func) {
    return pci_read_config_word(bus, slot, func, PCI_SUBSYSTEM_ID_OFFSET);
}
U8 pci_is_multi_function_device(U8 bus, U8 slot) {
    return (pci_read_config_byte(bus, slot, 0, PCI_HEADER_TYPE_OFFSET) & 0x80) != 0;
}

// Simple function to check if a device supports a capability
U8 pci_device_has_capability(U8 bus, U8 slot, U8 func, U8 cap_id) {
    U32 ptr = pci_get_capabilities_pointer(bus, slot, func);
    while(ptr) {
        if(pci_read_config_byte(bus, slot, func, ptr) == cap_id) return 1;
        ptr = pci_read_config_byte(bus, slot, func, ptr + 1);
    }
    return 0;
}

U8 pci_find_capability(U8 bus, U8 slot, U8 func, U8 cap_id) {
    U32 ptr = pci_get_capabilities_pointer(bus, slot, func);
    while(ptr) {
        if(pci_read_config_byte(bus, slot, func, ptr) == cap_id) return ptr;
        ptr = pci_read_config_byte(bus, slot, func, ptr + 1);
    }
    return 0;
}

// Scan all buses/devices/functions to find first IDE controller
BOOLEAN pci_find_ide_controller(U8* out_bus, U8* out_slot, U8* out_func) {
    for(U8 bus = 0; bus < PCI_MAX_BUS; bus++) {
        for(U8 slot = 0; slot < PCI_MAX_SLOTS; slot++) {
            U8 funcs = pci_is_multi_function_device(bus, slot) ? 8 : 1;
            for(U8 func = 0; func < funcs; func++) {
                if(pci_get_class(bus, slot, func) == PCI_CLASS_MASS_STORAGE &&
                   pci_get_subclass(bus, slot, func) == PCI_SUBCLASS_IDE) {
                    *out_bus = bus;
                    *out_slot = slot;
                    *out_func = func;
                    return TRUE;
                }
            }
        }
    }
    return FALSE;
}


// Enumerate all PCI devices and fill pci_devices[]
void pci_enumerate_devices(void) {
    pci_device_count = 0;

    for (U8 bus = 0; bus < PCI_MAX_BUS; bus++) {
        for (U8 slot = 0; slot < PCI_MAX_SLOTS; slot++) {
            // Check if this slot is multi-function
            U8 funcs = pci_is_multi_function_device(bus, slot) ? 8 : 1;

            for (U8 func = 0; func < funcs; func++) {
                U16 vendor_id = pci_get_vendor_id(bus, slot, func);
                if (vendor_id == 0xFFFF) continue; // No device here

                if (pci_device_count >= PCI_MAX_DEVICES) return; // Array full

                pci_device_entry_t* dev = &pci_devices[pci_device_count++];
                dev->bus  = bus;
                dev->slot = slot;
                dev->func = func;

                // Fill Type0 header fields
                pci_type0_header_t* h = &dev->header;
                h->vendor_id       = vendor_id;
                h->device_id       = pci_get_device_id(bus, slot, func);
                h->command         = pci_get_command(bus, slot, func);
                h->status          = pci_get_status(bus, slot, func);
                h->revision_id     = pci_read_config_byte(bus, slot, func, PCI_REVISION_ID_OFFSET);
                h->prog_if         = pci_get_prog_if(bus, slot, func);
                h->subclass        = pci_get_subclass(bus, slot, func);
                h->class_code      = pci_get_class(bus, slot, func);
                h->cache_line_size = pci_read_config_byte(bus, slot, func, 0x0C);
                h->latency_timer   = pci_read_config_byte(bus, slot, func, 0x0D);
                h->header_type     = pci_get_header_type(bus, slot, func);
                h->bist            = pci_read_config_byte(bus, slot, func, 0x0F);

                // Read BARs
                h->bar0 = pci_get_bar0(bus, slot, func);
                h->bar1 = pci_get_bar1(bus, slot, func);
                h->bar2 = pci_get_bar2(bus, slot, func);
                h->bar3 = pci_get_bar3(bus, slot, func);
                h->bar4 = pci_get_bar4(bus, slot, func);
                h->bar5 = pci_get_bar5(bus, slot, func);

                // Other fields
                h->subsystem_vendor_id = pci_get_subsystem_vendor_id(bus, slot, func);
                h->subsystem_id        = pci_get_subsystem_id(bus, slot, func);
                h->capabilities_pointer = pci_get_capabilities_pointer(bus, slot, func);
                h->interrupt_line      = pci_get_interrupt_line(bus, slot, func);
                h->interrupt_pin       = pci_get_interrupt_pin(bus, slot, func);

                // Optional: you could fill expansion_rom_base, min_grant, max_latency, etc.
            }
        }
    }
}

U32 pci_get_device_count(void) {
    return pci_device_count;
}
pci_device_entry_t* pci_get_device(U32 index) {
    if(index >= pci_device_count) return NULL;
    return &pci_devices[index];
}
pci_device_entry_t* pci_get_list(void) {
    return pci_devices;
}
void pci_initialize(void) {
    pci_enumerate_devices();
}




boolean find_device_by_class(U8 class_code, U8 subclass, U8 prog_if, pci_device_entry_t* out_device) {
    for (U32 i = 0; i < pci_device_count; i++) {
        pci_device_entry_t* dev = &pci_devices[i];
        if (dev->header.class_code == class_code &&
            dev->header.subclass == subclass &&
            (prog_if == 0xFF || dev->header.prog_if == prog_if)) {
            if (out_device) {
                *out_device = *dev;
            }
            return TRUE;
        }
    }
    return FALSE;
}