#define DEFAULT_HEAP_PAGES (65536 / PAGE_SIZE)

// Magic values help detect heap corruption, like buffer overflows or invalid frees.
#define KHEAP_BLOCK_MAGIC0 0xDEADBEEF
#define KHEAP_BLOCK_MAGIC1 0xFEEBDAED
#define KHEAP_BLOCK_MAGIC2 0xDABBADAF

typedef struct _heap_block {
    U32 magic0;       // Magic value to validate block integrity
    U32 size;         // User-requested size (payload size)
    U32 magic1;       // Another magic value for extra validation
    U32 real_size;    // Allocated payload size (after alignment)
    BOOLEAN free;     // Flag indicating if the block is free
    U32 magic2;       // A third magic value
} heap_block;

/// @brief Structure holding information about the kernel heap.
typedef struct _heap {
    U32 totalSize;      // Total size of the heap region in bytes
    U32 usedSize;       // Sum of real_size of all used blocks
    U32 freeSize;       // Sum of real_size of all free blocks
    VOIDPTR baseAddress;  // Start address of the heap
    VOIDPTR currentPtr;   // Pointer for the next-fit search start
    BOOLEAN initialized;
    U32 heap_init_pages;
} heap_info;

#define KHEAP_ALIGN 8
// #define ALIGN_UP_U32(x, a) ( (((U32)(x)) + ((a) - 1u)) & ~((a) - 1u) )

void validate_block(KHeapBlock* block) {
    panic_if(block->magic0 != KHEAP_BLOCK_MAGIC0, "heap_block magic0 corruption", PANIC_HEAP, (U32)block);
    panic_if(block->magic1 != KHEAP_BLOCK_MAGIC1, "heap_block magic1 corruption", PANIC_HEAP, (U32)block);
    panic_if(block->magic2 != KHEAP_BLOCK_MAGIC2, "heap_block magic2 corruption", PANIC_HEAP, (U32)block);
}

heap_info heap;

BOOLEAN heap_init(U32 pageNum) {
    if(heap.initialized) return true;
    panic_if(pageNum == 0, "KHEAP_INIT with zero pages", PANIC_HEAP, 0);

    U32 heap_phys_base = pf_alloc_pages(pageNum);
    panic_if(heap_phys_base == 0, "heap_init failed to allocate contiguous pages", PANIC_HEAP, pageNum);

    heap.baseAddress = heap_phys_base;
    heap.totalSize = pageNum*PAGE_SIZE;
    heap.usedSize=0;
    heap.freeSize = heap.totalSize-sizeof(heap_block);
    heap.currentPtr = heap.baseAddress;
    heap.heap_init_pages = pageNum;

    // initial free heap block
    heap_block *first_block = heap.baseAddress;
    first_block->magic0 = KHEAP_BLOCK_MAGIC0;
    first_block->magic1 = KHEAP_BLOCK_MAGIC1;
    first_block->magic2 = KHEAP_BLOCK_MAGIC2;
    first_block->size = heap.freeSize;
    first_block->real_size = heap.freeSize;
    first_block->free = true;

    heap.initialized = TRUE;
    return true;
}