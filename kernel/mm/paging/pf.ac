#ifndef PAGEFRAME_AC
#define PAGEFRAME_AC

/*
 * kernel/mm/paging/pageframe.ac — Physical Page Frame Allocator (PMM)
 */

#define PAGE_SIZE 0x1000
#define TOTAL_PAGES 0x100000 // 1,048,576 pages for 4GB
#define PAGEFRAME_BITMAP_DATA_SZ 131072 // 128 KB bitmap (1,048,576 / 8)

#define PAGESTATE_FREE 0
#define PAGESTATE_ALLOCATED 1

typedef struct _pg_info {
    U32 totalMemory;     // in bytes
    U32 freeMemory;      // in bytes
    U32 usedMemory;      // in bytes
    U32 reservedMemory;  // in bytes
    U32 totalPages;
    U32 freePages;
    U32 usedPages;
    U32 reservedPages;
    U32 pIndex;          // last search position
    BOOLEAN initialized;
} pg_info;

pg_info g_pg;
bitmap g_pg_bm;
U8 g_pg_bm_data[PAGEFRAME_BITMAP_DATA_SZ];

U32 pages_from_bytes(U32 bytes) {
    if (bytes == 0) return 0;
    return (bytes + PAGE_SIZE - 1) / PAGE_SIZE;
}

BOOLEAN pg_init() {
    if (g_pg.initialized) return TRUE;

    bm_create(PAGEFRAME_BITMAP_DATA_SZ, (VOIDPTR)&g_pg_bm_data, &g_pg_bm);
    if (!g_pg_bm.data) return FALSE;

    // Default ALL 4GB pages to ALLOCATED (Safe by default)
    memset(g_pg_bm.data, 0xFF, PAGEFRAME_BITMAP_DATA_SZ);

    U32 e820_cnt = 0;
    if (gkt) {
        PU32 pcnt = (PU32)(((PU8)gkt) + 640);
        e820_cnt = *pcnt;
    }

    U32 max_ram_addr = 0;
    if (e820_cnt > 0) {
        max_ram_addr = e820_get_max_address((E820_ENTRY*)gkt, e820_cnt);
    }

    // If E820 is empty or reported 0, fallback to 32 MB default PC RAM
    if (max_ram_addr == 0) {
        max_ram_addr = 0x02000000; // 32 MB
    }

    U32 total_ram_pages = pages_from_bytes(max_ram_addr);
    if (total_ram_pages > TOTAL_PAGES) {
        total_ram_pages = TOTAL_PAGES;
    }

    // Mark genuine E820 usable RAM regions as FREE
    if (e820_cnt > 0) {
        for (U32 i = 0; i < e820_cnt; i++) {
            U32 base = 0;
            U32 len = 0;
            U32 type = 0;
            e820_get_entry((E820_ENTRY*)gkt, i, &base, &len, &type);
            if (type == E820_TYPE_RAM) {
                U32 start_page = base / PAGE_SIZE;
                U32 page_count = len / PAGE_SIZE;

                for (U32 p = start_page; p < start_page + page_count; p++) {
                    if (p < total_ram_pages) {
                        bm_set(&g_pg_bm, p, PAGESTATE_FREE);
                    }
                }
            }
        }
    } else {
        // Fallback: mark RAM from 1MB to max_ram_addr as FREE
        for (U32 p = 256; p < total_ram_pages; p++) {
            bm_set(&g_pg_bm, p, PAGESTATE_FREE);
        }
    }

    // 1. Protect Low 1MB (Pages 0 - 255: IVT, BDA, EBDA, Bootloader, Kernel 0x10000, Stack, VGA, BIOS)
    for (U32 p = 0; p < 256; p++) {
        if (p < TOTAL_PAGES) {
            bm_set(&g_pg_bm, p, PAGESTATE_ALLOCATED);
        }
    }

    // 2. Protect Initial Page Directory & Tables (Pages 256 - 1023: 0x00100000 to 0x00400000 = 3MB)
    // Only reserve if we have enough RAM above 4MB
    if (total_ram_pages > 1024) {
        for (U32 p = 256; p < 1024; p++) {
            if (p < TOTAL_PAGES) {
                bm_set(&g_pg_bm, p, PAGESTATE_ALLOCATED);
            }
        }
        g_pg.pIndex = 1024; // Start allocations above 4MB
    } else {
        // For small memory setups, start allocations above kernel image (e.g. 1MB)
        for (U32 p = 256; p < 260; p++) {
            if (p < TOTAL_PAGES) {
                bm_set(&g_pg_bm, p, PAGESTATE_ALLOCATED);
            }
        }
        g_pg.pIndex = 260;
    }

    // Calculate memory statistics
    g_pg.totalMemory = total_ram_pages * PAGE_SIZE;
    g_pg.freeMemory = 0;
    g_pg.usedMemory = 0;
    g_pg.reservedMemory = 0;
    g_pg.totalPages = total_ram_pages;
    g_pg.freePages = 0;
    g_pg.usedPages = 0;
    g_pg.reservedPages = 0;

    for (U32 i = 0; i < total_ram_pages; i++) {
        U32 state = bm_get(&g_pg_bm, i);
        if (state == PAGESTATE_FREE) {
            g_pg.freeMemory += PAGE_SIZE;
            g_pg.freePages++;
        } else {
            g_pg.reservedMemory += PAGE_SIZE;
            g_pg.reservedPages++;
        }
    }

    g_pg.initialized = TRUE;
    dcomprintf("[PMM] Pageframe init complete: %d MB Total RAM, %d MB Free (%d pages)",
               g_pg.totalMemory / (1024 * 1024), g_pg.freeMemory / (1024 * 1024), g_pg.freePages);
    return TRUE;
}

U32 pf_alloc_pages(U32 count) {
    if (!g_pg.initialized || count == 0) return 0;

    U32 free_found = 0;
    U32 start_page = 0;
    U32 search_limit = g_pg.totalPages;

    // Search from pIndex to end
    for (U32 i = g_pg.pIndex; i < search_limit; i++) {
        if (bm_get(&g_pg_bm, i) == PAGESTATE_FREE) {
            if (free_found == 0) start_page = i;
            free_found++;
            if (free_found == count) {
                for (U32 p = start_page; p < start_page + count; p++) {
                    bm_set(&g_pg_bm, p, PAGESTATE_ALLOCATED);
                }
                U32 alloc_bytes = count * PAGE_SIZE;
                g_pg.freeMemory -= alloc_bytes;
                g_pg.usedMemory += alloc_bytes;
                g_pg.freePages -= count;
                g_pg.usedPages += count;
                g_pg.pIndex = start_page + count;
                
                U32 addr = start_page * PAGE_SIZE;
                memzero((PU8)addr, alloc_bytes);
                return addr;
            }
        } else {
            free_found = 0;
        }
    }

    // Wrap around search from page 260 to pIndex
    free_found = 0;
    for (U32 i = 260; i < g_pg.pIndex; i++) {
        if (bm_get(&g_pg_bm, i) == PAGESTATE_FREE) {
            if (free_found == 0) start_page = i;
            free_found++;
            if (free_found == count) {
                for (U32 p = start_page; p < start_page + count; p++) {
                    bm_set(&g_pg_bm, p, PAGESTATE_ALLOCATED);
                }
                U32 alloc_bytes = count * PAGE_SIZE;
                g_pg.freeMemory -= alloc_bytes;
                g_pg.usedMemory += alloc_bytes;
                g_pg.freePages -= count;
                g_pg.usedPages += count;
                g_pg.pIndex = start_page + count;

                U32 addr = start_page * PAGE_SIZE;
                memzero((PU8)addr, alloc_bytes);
                return addr;
            }
        } else {
            free_found = 0;
        }
    }

    return 0; // Out of physical memory
}

U32 pf_alloc_page() {
    return pf_alloc_pages(1);
}

VOID pf_free_pages(U32 phys_addr, U32 count) {
    if (!g_pg.initialized || phys_addr == 0 || count == 0) return;
    if ((phys_addr & 0xFFF) != 0) return; // Must be page-aligned

    U32 start_page = phys_addr / PAGE_SIZE;
    if (start_page < 256) return; // Do not free protected low 1MB memory!

    for (U32 p = start_page; p < start_page + count; p++) {
        if (p < g_pg.totalPages) {
            if (bm_get(&g_pg_bm, p) == PAGESTATE_ALLOCATED) {
                bm_set(&g_pg_bm, p, PAGESTATE_FREE);
                g_pg.freePages++;
                if (g_pg.usedPages > 0) g_pg.usedPages--;
            }
        }
    }

    U32 free_bytes = count * PAGE_SIZE;
    g_pg.freeMemory += free_bytes;
    if (g_pg.usedMemory >= free_bytes) {
        g_pg.usedMemory -= free_bytes;
    } else {
        g_pg.usedMemory = 0;
    }
}

VOID pf_free_page(U32 phys_addr) {
    pf_free_pages(phys_addr, 1);
}

VOID pf_dump() {
    dcomprintf("[PMM] Memory Status: %d/%d MB Used, %d MB Free (%d free pages)",
               g_pg.usedMemory / (1024 * 1024),
               g_pg.totalMemory / (1024 * 1024),
               g_pg.freeMemory / (1024 * 1024),
               g_pg.freePages);
}

#endif // PAGEFRAME_AC