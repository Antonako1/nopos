#ifndef E820_AC
#define E820_AC

/*
 * kernel/mm/e820/e820.ac — BIOS E820 memory map parser and querying
 */

typedef struct _E820_ENTRY {
    U32 BaseAddressLow;
    U32 BaseAddressHigh;
    U32 LengthLow;
    U32 LengthHigh;
    U32 Type;
} E820_ENTRY;

#define E820_MAX_ENTRIES 32

#define E820_TYPE_RAM               0x01
#define E820_TYPE_RESERVED          0x02
#define E820_TYPE_ACPI_RECLAIMABLE  0x03
#define E820_TYPE_ACPI_NVS          0x04
#define E820_TYPE_BAD               0x05

PU8 e820_type_str(U32 type) {
    if (type == E820_TYPE_RAM) return "RAM (Usable)";
    if (type == E820_TYPE_RESERVED) return "Reserved";
    if (type == E820_TYPE_ACPI_RECLAIMABLE) return "ACPI Reclaimable";
    if (type == E820_TYPE_ACPI_NVS) return "ACPI NVS";
    if (type == E820_TYPE_BAD) return "Bad Memory";
    return "Unknown";
}

U0 e820_get_entry(E820_ENTRY *entries, U32 index, PU32 out_base, PU32 out_len, PU32 out_type) {
    // Each E820 entry is exactly 20 bytes (5 * 4 bytes)
    PU32 raw = (PU32)(((PU8)entries) + (index * 20));
    if (out_base) *out_base = raw[0];
    if (out_len)  *out_len  = raw[2];
    if (out_type) *out_type = raw[4];
}

U0 e820_dump(E820_ENTRY *entries, U32 count) {
    if (!entries || count == 0) {
        dcomputs("[E820] No memory map entries found.\n");
        return;
    }
    dcomprintf("[E820] Memory Map (%d entries):\n", count);
    for (U32 i = 0; i < count; i++) {
        U32 base = 0;
        U32 len = 0;
        U32 type = 0;
        e820_get_entry(entries, i, &base, &len, &type);
        dcomprintf("  #%d: Base=0x%08X Len=0x%08X Type=%d (%s)\n",
                   i, base, len, type, e820_type_str(type));
    }
}

U32 e820_get_total_ram_bytes(E820_ENTRY *entries, U32 count) {
    if (!entries || count == 0) return 0;
    U32 total = 0;
    for (U32 i = 0; i < count; i++) {
        U32 base = 0;
        U32 len = 0;
        U32 type = 0;
        e820_get_entry(entries, i, &base, &len, &type);
        if (type == E820_TYPE_RAM) {
            total += len;
        }
    }
    return total;
}

U32 e820_get_max_address(E820_ENTRY *entries, U32 count) {
    if (!entries || count == 0) return 0;
    U32 max_addr = 0;
    for (U32 i = 0; i < count; i++) {
        U32 base = 0;
        U32 len = 0;
        U32 type = 0;
        e820_get_entry(entries, i, &base, &len, &type);
        if (type == E820_TYPE_RAM) {
            U32 end_addr = base + len;
            if (end_addr > max_addr) {
                max_addr = end_addr;
            }
        }
    }
    return max_addr;
}

#endif // E820_AC