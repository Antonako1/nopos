/*
Function table:
  void FAT12_INIT(FAT12_VOL *vol, PU8 ram_base);
  U16  FAT12_GET_FAT_ENTRY(FAT12_VOL *vol, U16 cluster);
  void FAT12_READ_CLUSTER(FAT12_VOL *vol, U16 cluster, PU8 buffer);
  U8   FAT12_FIND_FILE(FAT12_VOL *vol, PU8 filename, FAT12_DIR_ENTRY *out_entry);
  void FAT12_READ_FILE(FAT12_VOL *vol, FAT12_DIR_ENTRY *entry, PU8 buffer);
  PU8  FAT12_GET_FILE_PTR(FAT12_VOL *vol, FAT12_DIR_ENTRY *entry);
*/

#define FAT12_EOF           0x0FF8
#define FAT12_BAD_CLUSTER   0x0FF7
#define DIR_ENTRY_FREE      0xE5
#define DIR_ENTRY_END       0x00

// BIOS Parameter Block (BPB) at Sector 0. Needs exact 1-byte packing.
typedef struct _FAT12_BPB {
  U8  Jump[3];
  U8  OEMName[8];
  U16 BytesPerSector;
  U8  SectorsPerCluster;
  U16 ReservedSectors;
  U8  NumberOfFATs;
  U16 RootDirEntries;
  U16 TotalSectors16;
  U8  MediaDescriptor;
  U16 SectorsPerFAT;
  U16 SectorsPerTrack;
  U16 Heads;
  U32 HiddenSectors;
  U32 TotalSectors32;
  U8  DriveNumber;
  U8  Reserved;
  U8  BootSignature;
  U32 VolumeID;
  U8  VolumeLabel[11];
  U8  FileSystemType[8];
} FAT12_BPB;

// 32-Byte FAT Directory Entry
typedef struct _FAT12_DIR_ENTRY {
  U8  Name[11];
  U8  Attributes;
  U8  Reserved;
  U8  CreationTimeTenths;
  U16 CreationTime;
  U16 CreationDate;
  U16 LastAccessDate;
  U16 FirstClusterHigh;
  U16 LastWriteTime;
  U16 LastWriteDate;
  U16 FirstClusterLow;
  U32 FileSize;
} FAT12_DIR_ENTRY;

// Context state for the mounted volume
typedef struct _FAT12_VOL {
  PU8       ram_base; // Physical RAM base pointer of the iPXE FAT12 memory image
  FAT12_BPB bpb;
  U32       fat_lba;
  U32       root_dir_lba;
  U32       data_lba;
  U32       root_dir_sectors;
  U32       bytes_per_cluster;
  
  // Entire FAT is typically 9 sectors (512*9=4608 bytes) for floppy disks. 
  U8        fat_buffer[4608]; 
} FAT12_VOL;

FAT12_VOL g_fat12_volume;

void FAT12_INIT(FAT12_VOL *vol, PU8 ram_base) {
  vol->ram_base = ram_base;
  if (!ram_base) {
    return;
  }

  // Parse BPB directly from RAM image Sector 0
  memcpy((PU8)&vol->bpb, ram_base, sizeof(FAT12_BPB));

  // Calculate sector boundaries based on BPB parameters
  vol->fat_lba = vol->bpb.ReservedSectors;
  vol->root_dir_sectors = (vol->bpb.RootDirEntries * 32 + vol->bpb.BytesPerSector - 1) / vol->bpb.BytesPerSector;
  vol->root_dir_lba = vol->fat_lba + (vol->bpb.NumberOfFATs * vol->bpb.SectorsPerFAT);
  vol->data_lba = vol->root_dir_lba + vol->root_dir_sectors;
  vol->bytes_per_cluster = vol->bpb.BytesPerSector * vol->bpb.SectorsPerCluster;

  // Cache File Allocation Table directly from RAM
  U32 fat_offset = vol->fat_lba * vol->bpb.BytesPerSector;
  memcpy(vol->fat_buffer, ram_base + fat_offset, vol->bpb.SectorsPerFAT * vol->bpb.BytesPerSector);

  dcomprintf("[FAT12] In-Memory Volume Initialized: Base=0x%08X, RootLBA=%d, DataLBA=%d\n",
             ram_base, vol->root_dir_lba, vol->data_lba);
}

// Unpack a 12-bit entry from the File Allocation Table
U16 FAT12_GET_FAT_ENTRY(FAT12_VOL *vol, U16 cluster) {
  U32 offset = cluster + (cluster / 2);
  U16 val = vol->fat_buffer[offset] | ((U16)vol->fat_buffer[offset + 1] << 8);

  if (cluster & 1) {
    return val >> 4;
  } else {
    return val & 0x0FFF;
  }
}

void FAT12_READ_CLUSTER(FAT12_VOL *vol, U16 cluster, PU8 buffer) {
  if (!vol->ram_base || !buffer) return;
  U32 lba = vol->data_lba + ((cluster - 2) * vol->bpb.SectorsPerCluster);
  PU8 src = vol->ram_base + (lba * vol->bpb.BytesPerSector);
  memcpy(buffer, src, vol->bytes_per_cluster);
}

PU8 FAT12_GET_FILE_PTR(FAT12_VOL *vol, FAT12_DIR_ENTRY *entry) {
  if (!vol->ram_base || !entry) return NULLPTR;
  U16 cluster = entry->FirstClusterLow;
  if (cluster < 2) return NULLPTR;
  U32 lba = vol->data_lba + ((cluster - 2) * vol->bpb.SectorsPerCluster);
  return vol->ram_base + (lba * vol->bpb.BytesPerSector);
}

U8 FAT12_FIND_FILE(FAT12_VOL *vol, PU8 filename, FAT12_DIR_ENTRY *out_entry) {
  if (!vol->ram_base) return 0;
  
  for (U32 i = 0; i < vol->root_dir_sectors; i = i + 1) {
    PU8 src = vol->ram_base + ((vol->root_dir_lba + i) * vol->bpb.BytesPerSector);
    FAT12_DIR_ENTRY *entry = (FAT12_DIR_ENTRY *)src;
    
    for (U32 j = 0; j < (vol->bpb.BytesPerSector / 32); j = j + 1) {
      if (entry[j].Name[0] == DIR_ENTRY_END) {
        return 0;
      }
      if (entry[j].Name[0] == DIR_ENTRY_FREE) {
        continue;
      }
      
      U8 match = 1;
      for (U32 k = 0; k < 11; k = k + 1) {
        if (entry[j].Name[k] != filename[k]) {
          match = 0;
          break;
        }
      }
      
      if (match) {
        *out_entry = entry[j];
        return 1;
      }
    }
  }
  return 0;
}

void FAT12_READ_FILE(FAT12_VOL *vol, FAT12_DIR_ENTRY *entry, PU8 buffer) {
  U16 cluster = entry->FirstClusterLow;
  U32 offset = 0;
  
  while (cluster >= 0x002 && cluster < FAT12_EOF) {
    FAT12_READ_CLUSTER(vol, cluster, buffer + offset);
    offset += vol->bytes_per_cluster;
    cluster = FAT12_GET_FAT_ENTRY(vol, cluster);
  }
}
