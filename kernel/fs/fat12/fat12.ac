/*
Function table:
  void FAT12_INIT(FAT12_VOL *vol, PU8 ram_base);
  U16  FAT12_GET_FAT_ENTRY(FAT12_VOL *vol, U16 cluster);
  void FAT12_READ_CLUSTER(FAT12_VOL *vol, U16 cluster, PU8 buffer);
  U8   FAT12_FIND_FILE(FAT12_VOL *vol, PU8 filename, FAT12_DIR_ENTRY *out_entry);
  void FAT12_READ_FILE(FAT12_VOL *vol, FAT12_DIR_ENTRY *entry, PU8 buffer);
  PU8  FAT12_GET_FILE_PTR(FAT12_VOL *vol, FAT12_DIR_ENTRY *entry);
*/

#define FAT12_EOF           0x0FF8
#define FAT12_BAD_CLUSTER   0x0FF7
#define DIR_ENTRY_FREE      0xE5
#define DIR_ENTRY_END       0x00

// BIOS Parameter Block (BPB) at Sector 0. Needs exact 1-byte packing.
typedef struct _FAT12_BPB {
  U8  Jump[3];
  U8  OEMName[8];
  U16 BytesPerSector;
  U8  SectorsPerCluster;
  U16 ReservedSectors;
  U8  NumberOfFATs;
  U16 RootDirEntries;
  U16 TotalSectors16;
  U8  MediaDescriptor;
  U16 SectorsPerFAT;
  U16 SectorsPerTrack;
  U16 Heads;
  U32 HiddenSectors;
  U32 TotalSectors32;
  U8  DriveNumber;
  U8  Reserved;
  U8  BootSignature;
  U32 VolumeID;
  U8  VolumeLabel[11];
  U8  FileSystemType[8];
} FAT12_BPB;

// 32-Byte FAT Directory Entry
typedef struct _FAT12_DIR_ENTRY {
  U8  Name[11];
  U8  Attributes;
  U8  Reserved;
  U8  CreationTimeTenths;
  U16 CreationTime;
  U16 CreationDate;
  U16 LastAccessDate;
  U16 FirstClusterHigh;
  U16 LastWriteTime;
  U16 LastWriteDate;
  U16 FirstClusterLow;
  U32 FileSize;
} FAT12_DIR_ENTRY;

// Context state for the mounted volume
typedef struct _FAT12_VOL {
  PU8       ram_base; // Physical RAM base pointer of the iPXE FAT12 memory image
  FAT12_BPB bpb;
  U32       fat_lba;
  U32       root_dir_lba;
  U32       data_lba;
  U32       root_dir_sectors;
  U32       bytes_per_cluster;
  
  // Entire FAT is typically 9 sectors (512*9=4608 bytes) for floppy disks. 
  U8        fat_buffer[4608]; 
} FAT12_VOL;

FAT12_VOL g_fat12_volume;

void FAT12_INIT(FAT12_VOL *vol, PU8 ram_base) {
  if (!vol || !ram_base) {
    return;
  }

  vol->ram_base = ram_base;

#ifdef FAT12_RETRIEVE_DATA
  // Unaligned byte-offset extraction from FAT12 Sector 0 BPB
  U16 bytes_per_sec   = (U16)ram_base[11] | ((U16)ram_base[12] << 8);
  U8  sec_per_cluster = ram_base[13];
  U16 res_sec         = (U16)ram_base[14] | ((U16)ram_base[15] << 8);
  U8  num_fats        = ram_base[16];
  U16 root_entries    = (U16)ram_base[17] | ((U16)ram_base[18] << 8);
  U16 sec_per_fat     = (U16)ram_base[22] | ((U16)ram_base[23] << 8);

  // Validate BPB values; fallback to standard 1.44MB FAT12 floppy geometry if 0 or corrupted
  if (bytes_per_sec == 0 || bytes_per_sec > 4096) bytes_per_sec = 512;
  if (sec_per_cluster == 0) sec_per_cluster = 1;
  if (res_sec == 0) res_sec = 1;
  if (num_fats == 0) num_fats = 2;
  if (root_entries == 0) root_entries = 224;
  if (sec_per_fat == 0) sec_per_fat = 9;

  vol->bpb.BytesPerSector = bytes_per_sec;
  vol->bpb.SectorsPerCluster = sec_per_cluster;
  vol->bpb.ReservedSectors = res_sec;
  vol->bpb.NumberOfFATs = num_fats;
  vol->bpb.RootDirEntries = root_entries;
  vol->bpb.SectorsPerFAT = sec_per_fat;

  // Calculate sector boundaries based on BPB parameters
  vol->fat_lba = res_sec;
  vol->root_dir_sectors = (root_entries * 32 + bytes_per_sec - 1) / bytes_per_sec;
  vol->root_dir_lba = vol->fat_lba + (num_fats * sec_per_fat);
  vol->data_lba = vol->root_dir_lba + vol->root_dir_sectors;
  vol->bytes_per_cluster = bytes_per_sec * sec_per_cluster;
#else
  // Standard 1.44MB FAT12 floppy geometry pasted directly from BOOTL.AS
  vol->bpb.BytesPerSector    = 512;
  vol->bpb.SectorsPerCluster = 1;
  vol->bpb.ReservedSectors   = 1;
  vol->bpb.NumberOfFATs      = 2;
  vol->bpb.RootDirEntries    = 224;
  vol->bpb.SectorsPerFAT     = 9;

  vol->fat_lba              = 1;
  vol->root_dir_sectors     = 14;
  vol->root_dir_lba         = 19;
  vol->data_lba             = 33;
  vol->bytes_per_cluster    = 512;
#endif

  // Cache File Allocation Table directly from RAM image
  U32 fat_offset = vol->fat_lba * vol->bpb.BytesPerSector;
  memcpy(vol->fat_buffer, ram_base + fat_offset, vol->bpb.SectorsPerFAT * vol->bpb.BytesPerSector);
}

// Unpack a 12-bit entry from the File Allocation Table
U16 FAT12_GET_FAT_ENTRY(FAT12_VOL *vol, U16 cluster) {
  U32 offset = cluster + (cluster / 2);
  U16 val = vol->fat_buffer[offset] | ((U16)vol->fat_buffer[offset + 1] << 8);

  if (cluster & 1) {
    return val >> 4;
  } else {
    return val & 0x0FFF;
  }
}

void FAT12_READ_CLUSTER(FAT12_VOL *vol, U16 cluster, PU8 buffer) {
  if (!vol->ram_base || !buffer) return;
  U32 lba = vol->data_lba + ((cluster - 2) * vol->bpb.SectorsPerCluster);
  PU8 src = vol->ram_base + (lba * vol->bpb.BytesPerSector);
  memcpy(buffer, src, vol->bytes_per_cluster);
}

PU8 FAT12_GET_FILE_PTR(FAT12_VOL *vol, FAT12_DIR_ENTRY *entry) {
  if (!vol->ram_base || !entry) return NULLPTR;
  U16 cluster = entry->FirstClusterLow;
  if (cluster < 2) return NULLPTR;
  U32 lba = vol->data_lba + ((cluster - 2) * vol->bpb.SectorsPerCluster);
  return vol->ram_base + (lba * vol->bpb.BytesPerSector);
}

U0 fat_to_83_name(PU8 src, PU8 dst) {
  memset(dst, ' ', 11);
  if (src == NULLPTR || *src == 0) return;

  if (strcmp(src, ".") == 0) {
    dst[0] = '.';
    return;
  }
  if (strcmp(src, "..") == 0) {
    dst[0] = '.';
    dst[1] = '.';
    return;
  }

  U32 ni = 0;
  PU8 p = src;
  while (*p != 0 && *p != '.' && ni < 8) {
    dst[ni] = c_toupper(*p);
    ni = ni + 1;
    p = p + 1;
  }
  if (*p == '.') {
    p = p + 1;
    U32 ei = 8;
    while (*p != 0 && ei < 11) {
      dst[ei] = c_toupper(*p);
      ei = ei + 1;
      p = p + 1;
    }
  }
}

U8 fat12_find_entry(FAT12_VOL *vol, U32 dir_cluster, PU8 filename, FAT12_DIR_ENTRY *out_entry) {
  if (!vol || !vol->ram_base || !filename || !out_entry) {
    return 0;
  }

  U8 target[11];
  fat_to_83_name(filename, target);

  if (dir_cluster == 0) {
    for (U32 i = 0; i < vol->root_dir_sectors; i = i + 1) {
      PU8 src = vol->ram_base + ((vol->root_dir_lba + i) * vol->bpb.BytesPerSector);
      FAT12_DIR_ENTRY *entry = (FAT12_DIR_ENTRY *)src;

      for (U32 j = 0; j < (vol->bpb.BytesPerSector / 32); j = j + 1) {
        if (entry[j].Name[0] == DIR_ENTRY_END) {
          return 0;
        }
        if (entry[j].Name[0] == DIR_ENTRY_FREE || (entry[j].Attributes & 0x08)) {
          continue;
        }

        if (memcmp(entry[j].Name, target, 11) == 0) {
          *out_entry = entry[j];
          return 1;
        }
      }
    }
    return 0;
  } else {
    U16 cluster = (U16)dir_cluster;
    U8 buf[512];
    while (cluster >= 0x002 && cluster < FAT12_EOF) {
      FAT12_READ_CLUSTER(vol, cluster, buf);
      FAT12_DIR_ENTRY *entry = (FAT12_DIR_ENTRY *)buf;
      for (U32 j = 0; j < (vol->bpb.BytesPerSector / 32); j = j + 1) {
        if (entry[j].Name[0] == DIR_ENTRY_END) {
          return 0;
        }
        if (entry[j].Name[0] == DIR_ENTRY_FREE || (entry[j].Attributes & 0x08)) {
          continue;
        }

        if (memcmp(entry[j].Name, target, 11) == 0) {
          *out_entry = entry[j];
          return 1;
        }
      }
      cluster = FAT12_GET_FAT_ENTRY(vol, cluster);
    }
    return 0;
  }
}

U8 FAT12_FIND_FILE(FAT12_VOL *vol, PU8 filename, FAT12_DIR_ENTRY *out_entry) {
  return fat12_find_entry(vol, 0, filename, out_entry);
}

void FAT12_READ_FILE(FAT12_VOL *vol, FAT12_DIR_ENTRY *entry, PU8 buffer) {
  U16 cluster = entry->FirstClusterLow;
  U32 offset = 0;
  
  while (cluster >= 0x002 && cluster < FAT12_EOF) {
    FAT12_READ_CLUSTER(vol, cluster, buffer + offset);
    offset += vol->bytes_per_cluster;
    cluster = FAT12_GET_FAT_ENTRY(vol, cluster);
  }
}