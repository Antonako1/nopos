/*
Function table:
  U0  vfs_init();
  U8  vfs_mount(PU8 dev_name, PU8 mount_path, U8 fs_type);
  U8  vfs_open(PU8 path, VFS_NODE *out_node);
  U32 vfs_read(VFS_NODE *node, U32 offset, U32 size, PU8 buffer);
  U32 vfs_write(VFS_NODE *node, PU8 data, U32 size);
  U8  vfs_readdir(VFS_NODE *dir_node, U32 index, VFS_DIR_ENTRY *out_entry);
  U8  vfs_mkdir(PU8 path);
  U8  vfs_touch(PU8 path);
  U8  vfs_remove(PU8 path);
  U0  vfs_list_drives();
*/

#define VFS_FS_FAT12 1
#define VFS_FS_FAT32 2

#define VFS_MAX_MOUNTS 8
#define VFS_TYPE_FILE  1
#define VFS_TYPE_DIR   2

typedef struct _VFS_DIR_ENTRY {
    U8  name[64];
    U32 size;
    U8  is_directory;
} VFS_DIR_ENTRY;

typedef struct _VFS_NODE {
    U8  name[64];
    U8  type; // VFS_TYPE_FILE or VFS_TYPE_DIR
    U32 size;
    U32 cluster;
    U8  mount_id;
    U8  fs_type;
} VFS_NODE;

typedef struct _T_VFS_MOUNT {
    U8        used;
    U8        dev_name[16];
    U8        mount_path[32];
    U8        fs_type;
    U8        drive;
    U32       lba_start;
    FAT12_VOL fat12_vol;
    FAT32_VOL fat32_vol;
} T_VFS_MOUNT;

T_VFS_MOUNT g_vfs_mounts[VFS_MAX_MOUNTS];
U8 g_sh_cwd[64];

U0 vfs_init() {
    dcomputs("[VFS] Initializing Virtual File System...");
    memzero((PU8)g_vfs_mounts, sizeof(T_VFS_MOUNT) * VFS_MAX_MOUNTS);
    strcpy(g_sh_cwd, "A:/");
    dcomputs("[VFS] Virtual File System initialized.");
}

U0 vfs_resolve_alias(PU8 path, PU8 out_resolved) {
    dcomprintf("[VFS] Resolving path: '%s'\n", path);
    if (strncmp(path, "A:", 2) == 0 || strncmp(path, "a:", 2) == 0) {
        strcpy(out_resolved, "ram0:/");
        PU8 rest = path + 2;
        if (*rest == '/') rest = rest + 1;
        strcat(out_resolved, rest);
    } else if (strncmp(path, "C:", 2) == 0 || strncmp(path, "c:", 2) == 0) {
        strcpy(out_resolved, "hd0p1:/");
        PU8 rest = path + 2;
        if (*rest == '/') rest = rest + 1;
        strcat(out_resolved, rest);
    } else {
        strcpy(out_resolved, path);
    }
    dcomprintf("[VFS] Resolved path: '%s'\n", out_resolved);
}

U8 vfs_mount(PU8 dev_name, PU8 mount_path, U8 fs_type) {
    I32 slot = -1;
    for (U32 i = 0; i < VFS_MAX_MOUNTS; i = i + 1) {
        if (g_vfs_mounts[i].used && strcmp(g_vfs_mounts[i].dev_name, dev_name) == 0) {
            slot = (I32)i;
            break;
        }
    }
    if (slot < 0) {
        for (U32 i = 0; i < VFS_MAX_MOUNTS; i = i + 1) {
            if (g_vfs_mounts[i].used == 0) {
                slot = (I32)i;
                break;
            }
        }
    }
    if (slot < 0) return 0;

    U32 i = (U32)slot;
    g_vfs_mounts[i].used = 1;
    strcpy(g_vfs_mounts[i].dev_name, dev_name);
    strcpy(g_vfs_mounts[i].mount_path, mount_path);
    g_vfs_mounts[i].fs_type = fs_type;
    dcomprintf("[VFS] Mounting device '%s' to '%s' with FS_Type=%d\n", dev_name, mount_path, fs_type);
    if (strcmp(dev_name, "ram0") == 0) {
        g_vfs_mounts[i].drive = 1;
        g_vfs_mounts[i].lba_start = 0;
        FAT12_INIT(&g_vfs_mounts[i].fat12_vol, g_ramdisk_base);
    } else if (strcmp(dev_name, "fd0") == 0) {
        g_vfs_mounts[i].drive = 0;
        g_vfs_mounts[i].lba_start = 0;
        FAT12_INIT(&g_vfs_mounts[i].fat12_vol, g_ramdisk_base);
    } else if (strcmp(dev_name, "hd0p1") == 0) {
        g_vfs_mounts[i].drive = 0;
        MBR_PARTITION_ENTRY part;
        if (mbr_find_fat32(0, &part)) {
            g_vfs_mounts[i].lba_start = part.start_lba;
        } else {
            g_vfs_mounts[i].lba_start = 2048; // Fallback default
        }
        fat32_init(0, g_vfs_mounts[i].lba_start, &g_vfs_mounts[i].fat32_vol);
    }

    dcomprintf("[VFS] Mounted '%s' on '%s' (FS_Type=%d)\n", dev_name, mount_path, fs_type);
    return 1;
}

I32 vfs_find_mount(PU8 path) {
    U8 resolved[128];
    vfs_resolve_alias(path, resolved);
    for (U32 i = 0; i < VFS_MAX_MOUNTS; i = i + 1) {
        if (g_vfs_mounts[i].used) {
            U32 mlen = strlen(g_vfs_mounts[i].mount_path);
            if (strncmp(resolved, g_vfs_mounts[i].mount_path, mlen) == 0) {
                return (I32)i;
            }
            if (strncmp(resolved, g_vfs_mounts[i].dev_name, strlen(g_vfs_mounts[i].dev_name)) == 0) {
                return (I32)i;
            }
        }
    }
    return -1;
}

U8 vfs_open(PU8 path, VFS_NODE *out_node) {
    U8 resolved[128];
    vfs_resolve_alias(path, resolved);

    I32 mid = vfs_find_mount(resolved);
    if (mid < 0) {
        return 0;
    }

    T_VFS_MOUNT *m = &g_vfs_mounts[mid];
    out_node->mount_id = (U8)mid;
    out_node->fs_type = m->fs_type;

    // Strip mount prefix
    PU8 rel_path = resolved;
    if (strncmp(resolved, m->mount_path, strlen(m->mount_path)) == 0) {
        rel_path = resolved + strlen(m->mount_path);
    } else if (strncmp(resolved, m->dev_name, strlen(m->dev_name)) == 0) {
        rel_path = resolved + strlen(m->dev_name);
        if (*rel_path == ':') rel_path = rel_path + 1;
    }
    while (*rel_path == '/') rel_path = rel_path + 1;

    strcpy(out_node->name, rel_path);

    // Strip trailing slashes
    U32 nlen = strlen(out_node->name);
    while (nlen > 0 && out_node->name[nlen - 1] == '/') {
        out_node->name[nlen - 1] = 0;
        nlen = nlen - 1;
    }

    if (nlen == 0) {
        out_node->type = VFS_TYPE_DIR;
        out_node->size = 0;
        out_node->cluster = (m->fs_type == VFS_FS_FAT32) ? m->fat32_vol.root_cluster : 0;
        return 1;
    }

    if (m->fs_type == VFS_FS_FAT12) {
        U32 curr_cluster = 0;
        U8 path_copy[128];
        strcpy(path_copy, out_node->name);

        PU8 p = path_copy;
        U8 node_type = VFS_TYPE_DIR;
        U32 node_size = 0;

        while (*p != 0) {
            while (*p == '/') p = p + 1;
            if (*p == 0) break;

            PU8 slash = strchr(p, '/');
            U8 comp[32];
            if (slash != NULLPTR) {
                U32 clen = (U32)(slash - p);
                if (clen >= 32) clen = 31;
                strncpy(comp, p, clen);
                comp[clen] = 0;
                p = slash + 1;
            } else {
                strncpy(comp, p, 31);
                comp[31] = 0;
                p = p + strlen(p);
            }

            FAT12_DIR_ENTRY entry;
            if (!fat12_find_entry(&m->fat12_vol, curr_cluster, comp, &entry)) {
                return 0;
            }

            if (entry.Attributes & 0x10) {
                curr_cluster = (U32)entry.FirstClusterLow;
                node_type = VFS_TYPE_DIR;
                node_size = 0;
            } else {
                while (*p == '/') p = p + 1;
                if (*p != 0) return 0;
                curr_cluster = (U32)entry.FirstClusterLow;
                node_type = VFS_TYPE_FILE;
                node_size = entry.FileSize;
            }
        }

        out_node->type = node_type;
        out_node->size = node_size;
        out_node->cluster = curr_cluster;
        return 1;
    } else if (m->fs_type == VFS_FS_FAT32) {
        U32 curr_cluster = m->fat32_vol.root_cluster;
        U8 path_copy[128];
        strcpy(path_copy, out_node->name);

        PU8 p = path_copy;
        U8 node_type = VFS_TYPE_DIR;
        U32 node_size = 0;

        while (*p != 0) {
            while (*p == '/') p = p + 1;
            if (*p == 0) break;

            PU8 slash = strchr(p, '/');
            U8 comp[32];
            if (slash != NULLPTR) {
                U32 clen = (U32)(slash - p);
                if (clen >= 32) clen = 31;
                strncpy(comp, p, clen);
                comp[clen] = 0;
                p = slash + 1;
            } else {
                strncpy(comp, p, 31);
                comp[31] = 0;
                p = p + strlen(p);
            }

            FAT12_DIR_ENTRY entry;
            if (!fat32_find_entry(&m->fat32_vol, curr_cluster, comp, &entry)) {
                return 0;
            }

            if (entry.Attributes & 0x10) {
                curr_cluster = ((U32)entry.FirstClusterHigh << 16) | (U32)entry.FirstClusterLow;
                if (curr_cluster == 0) {
                    curr_cluster = m->fat32_vol.root_cluster;
                }
                node_type = VFS_TYPE_DIR;
                node_size = 0;
            } else {
                while (*p == '/') p = p + 1;
                if (*p != 0) return 0;
                curr_cluster = ((U32)entry.FirstClusterHigh << 16) | (U32)entry.FirstClusterLow;
                node_type = VFS_TYPE_FILE;
                node_size = entry.FileSize;
            }
        }

        out_node->type = node_type;
        out_node->size = node_size;
        out_node->cluster = curr_cluster;
        return 1;
    }
    return 0;
}

U32 vfs_read(VFS_NODE *node, U32 offset, U32 size, PU8 buffer) {
    if (node->mount_id >= VFS_MAX_MOUNTS) {
        return 0;
    }
    T_VFS_MOUNT *m = &g_vfs_mounts[node->mount_id];

    if (m->fs_type == VFS_FS_FAT12) {
        FAT12_DIR_ENTRY entry;
        entry.FirstClusterLow = (U16)node->cluster;
        entry.FileSize = node->size;
        FAT12_READ_FILE(&m->fat12_vol, &entry, buffer);
        return node->size;
    } else if (m->fs_type == VFS_FS_FAT32) {
        FAT12_DIR_ENTRY entry;
        entry.FirstClusterHigh = (U16)(node->cluster >> 16);
        entry.FirstClusterLow = (U16)(node->cluster & 0xFFFF);
        entry.FileSize = node->size;
        dcomprintf("[VFS] Reading file: '%s'\n", node->name);
        fat32_read_file(&m->fat32_vol, &entry, buffer);
        return node->size;
    }
    return 0;
}

local U32 vfs_get_parent_dir_cluster(FAT32_VOL *vol, PU8 path, PU8 out_filename) {
    PU8 last_slash = strrchr(path, '/');
    if (last_slash == NULLPTR) {
        strcpy(out_filename, path);
        return vol->root_cluster;
    }

    U8 dir_part[128];
    U32 dlen = (U32)(last_slash - path);
    strncpy(dir_part, path, dlen);
    dir_part[dlen] = 0;
    strcpy(out_filename, last_slash + 1);

    U32 curr_cluster = vol->root_cluster;
    PU8 p = dir_part;
    while (*p != 0) {
        PU8 slash = strchr(p, '/');
        U8 component[32];
        if (slash != NULLPTR) {
            U32 clen = (U32)(slash - p);
            strncpy(component, p, clen);
            component[clen] = 0;
            p = slash + 1;
        } else {
            strcpy(component, p);
            p = p + strlen(p);
        }

        if (strlen(component) == 0) continue;

        FAT12_DIR_ENTRY entry;
        if (fat32_find_entry(vol, curr_cluster, component, &entry)) {
            if (entry.Attributes & 0x10) {
                curr_cluster = ((U32)entry.FirstClusterHigh << 16) | (U32)entry.FirstClusterLow;
                if (curr_cluster == 0) {
                    curr_cluster = vol->root_cluster;
                }
            } else {
                return 0;
            }
        } else {
            return 0;
        }
    }
    return curr_cluster;
}

U32 vfs_write(VFS_NODE *node, PU8 data, U32 size) {
    if (node->mount_id >= VFS_MAX_MOUNTS) {
        return 0;
    }
    T_VFS_MOUNT *m = &g_vfs_mounts[node->mount_id];

    if (m->fs_type == VFS_FS_FAT32) {
        U8 filename[64];
        U32 dir_cluster = vfs_get_parent_dir_cluster(&m->fat32_vol, node->name, filename);
        if (dir_cluster == 0) {
            return 0;
        }
        fat32_create_file(&m->fat32_vol, dir_cluster, filename, data, size);
        return size;
    }
    return 0;
}

U8 vfs_readdir(VFS_NODE *dir_node, U32 index, VFS_DIR_ENTRY *out_entry) {
    if (dir_node->mount_id >= VFS_MAX_MOUNTS) {
        return 0;
    }
    T_VFS_MOUNT *m = &g_vfs_mounts[dir_node->mount_id];

    if (m->fs_type == VFS_FS_FAT12) {
        FAT12_VOL *vol = &m->fat12_vol;
        U32 match_count = 0;

        if (dir_node->cluster == 0) {
            for (U32 i = 0; i < vol->root_dir_sectors; i = i + 1) {
                PU8 src = vol->ram_base + ((vol->root_dir_lba + i) * vol->bpb.BytesPerSector);
                FAT12_DIR_ENTRY *entry = (FAT12_DIR_ENTRY *)src;

                for (U32 j = 0; j < (vol->bpb.BytesPerSector / 32); j = j + 1) {
                    if (entry[j].Name[0] == DIR_ENTRY_END) {
                        return 0;
                    }
                    if (entry[j].Name[0] == DIR_ENTRY_FREE || (entry[j].Attributes & 0x08)) {
                        continue;
                    }
                    if (match_count == index) {
                        U32 p = 0;
                        for (U32 k = 0; k < 8; k = k + 1) {
                            if (entry[j].Name[k] != ' ') {
                                out_entry->name[p] = entry[j].Name[k];
                                p = p + 1;
                            }
                        }
                        if (entry[j].Name[8] != ' ') {
                            out_entry->name[p] = '.';
                            p = p + 1;
                            for (U32 k = 8; k < 11; k = k + 1) {
                                if (entry[j].Name[k] != ' ') {
                                    out_entry->name[p] = entry[j].Name[k];
                                    p = p + 1;
                                }
                            }
                        }
                        out_entry->name[p] = 0;
                        out_entry->size = entry[j].FileSize;
                        out_entry->is_directory = (entry[j].Attributes & 0x10) ? 1 : 0;
                        return 1;
                    }
                    match_count = match_count + 1;
                }
            }
            return 0;
        } else {
            U16 cluster = (U16)dir_node->cluster;
            U8 buf[512];
            while (cluster >= 0x002 && cluster < FAT12_EOF) {
                FAT12_READ_CLUSTER(vol, cluster, buf);
                FAT12_DIR_ENTRY *entry = (FAT12_DIR_ENTRY *)buf;
                for (U32 j = 0; j < (vol->bpb.BytesPerSector / 32); j = j + 1) {
                    if (entry[j].Name[0] == DIR_ENTRY_END) {
                        return 0;
                    }
                    if (entry[j].Name[0] == DIR_ENTRY_FREE || (entry[j].Attributes & 0x08)) {
                        continue;
                    }
                    if (match_count == index) {
                        U32 p = 0;
                        for (U32 k = 0; k < 8; k = k + 1) {
                            if (entry[j].Name[k] != ' ') {
                                out_entry->name[p] = entry[j].Name[k];
                                p = p + 1;
                            }
                        }
                        if (entry[j].Name[8] != ' ') {
                            out_entry->name[p] = '.';
                            p = p + 1;
                            for (U32 k = 8; k < 11; k = k + 1) {
                                if (entry[j].Name[k] != ' ') {
                                    out_entry->name[p] = entry[j].Name[k];
                                    p = p + 1;
                                }
                            }
                        }
                        out_entry->name[p] = 0;
                        out_entry->size = entry[j].FileSize;
                        out_entry->is_directory = (entry[j].Attributes & 0x10) ? 1 : 0;
                        return 1;
                    }
                    match_count = match_count + 1;
                }
                cluster = FAT12_GET_FAT_ENTRY(vol, cluster);
            }
            return 0;
        }
    } else if (m->fs_type == VFS_FS_FAT32) {
        U8 cluster_buf[4096];
        U32 target_cluster = (dir_node->cluster != 0) ? dir_node->cluster : m->fat32_vol.root_cluster;
        U32 match_count = 0;

        while (target_cluster >= 2 && target_cluster < FAT32_EOF) {
            fat32_read_cluster(&m->fat32_vol, target_cluster, cluster_buf);
            U32 entries = m->fat32_vol.bytes_per_cluster / 32;

            for (U32 i = 0; i < entries; i = i + 1) {
                FAT12_DIR_ENTRY *dir = (FAT12_DIR_ENTRY *)(cluster_buf + (i * 32));
                if (dir->Name[0] == DIR_ENTRY_END) {
                    return 0;
                }
                if (dir->Name[0] == DIR_ENTRY_FREE || (dir->Attributes & 0x0F) == FAT32_ATTR_LFN || ((dir->Attributes & 0x08) && !(dir->Attributes & 0x10))) {
                    continue;
                }
                if (dir->Name[0] < 0x20 && dir->Name[0] != 0x05) {
                    continue;
                }
                if (match_count == index) {
                    U32 p = 0;
                    for (U32 k = 0; k < 8; k = k + 1) {
                        if (dir->Name[k] != ' ') {
                            out_entry->name[p] = dir->Name[k];
                            p = p + 1;
                        }
                    }
                    if (dir->Name[8] != ' ') {
                        out_entry->name[p] = '.';
                        p = p + 1;
                        for (U32 k = 8; k < 11; k = k + 1) {
                            if (dir->Name[k] != ' ') {
                                out_entry->name[p] = dir->Name[k];
                                p = p + 1;
                            }
                        }
                    }
                    out_entry->name[p] = 0;
                    out_entry->size = dir->FileSize;
                    out_entry->is_directory = (dir->Attributes & 0x10) ? 1 : 0;
                    return 1;
                }
                match_count = match_count + 1;
            }
            target_cluster = fat32_get_fat_entry(&m->fat32_vol, target_cluster);
        }
    }
    return 0;
}

U8 vfs_mkdir(PU8 path) {
    U8 resolved[128];
    vfs_resolve_alias(path, resolved);

    I32 mid = vfs_find_mount(resolved);
    if (mid < 0) return 0;

    T_VFS_MOUNT *m = &g_vfs_mounts[mid];
    if (m->fs_type == VFS_FS_FAT12) {
        shell_puts((PU8)"Error: RAMDisk (A:/) is read-only.\n");
        return 0;
    }

    PU8 rel_path = resolved;
    if (strncmp(resolved, m->mount_path, strlen(m->mount_path)) == 0) {
        rel_path = resolved + strlen(m->mount_path);
    } else if (strncmp(resolved, m->dev_name, strlen(m->dev_name)) == 0) {
        rel_path = resolved + strlen(m->dev_name);
        if (*rel_path == ':') rel_path = rel_path + 1;
    }
    if (*rel_path == '/') rel_path = rel_path + 1;

    U8 dirname[64];
    U32 dir_cluster = vfs_get_parent_dir_cluster(&m->fat32_vol, rel_path, dirname);
    if (dir_cluster == 0) return 0;

    return fat32_mkdir(&m->fat32_vol, dir_cluster, dirname);
}

U8 vfs_touch(PU8 path) {
    U8 resolved[128];
    vfs_resolve_alias(path, resolved);

    I32 mid = vfs_find_mount(resolved);
    if (mid < 0) return 0;

    T_VFS_MOUNT *m = &g_vfs_mounts[mid];
    if (m->fs_type == VFS_FS_FAT12) {
        shell_puts((PU8)"Error: RAMDisk (A:/) is read-only.\n");
        return 0;
    }

    PU8 rel_path = resolved;
    if (strncmp(resolved, m->mount_path, strlen(m->mount_path)) == 0) {
        rel_path = resolved + strlen(m->mount_path);
    } else if (strncmp(resolved, m->dev_name, strlen(m->dev_name)) == 0) {
        rel_path = resolved + strlen(m->dev_name);
        if (*rel_path == ':') rel_path = rel_path + 1;
    }
    if (*rel_path == '/') rel_path = rel_path + 1;

    U8 filename[64];
    U32 dir_cluster = vfs_get_parent_dir_cluster(&m->fat32_vol, rel_path, filename);
    if (dir_cluster == 0) return 0;

    return fat32_create_file(&m->fat32_vol, dir_cluster, filename, (PU8)"", 0);
}

U8 vfs_remove(PU8 path) {
    U8 resolved[128];
    vfs_resolve_alias(path, resolved);

    I32 mid = vfs_find_mount(resolved);
    if (mid < 0) return 0;

    T_VFS_MOUNT *m = &g_vfs_mounts[mid];
    if (m->fs_type == VFS_FS_FAT12) {
        shell_puts((PU8)"Error: RAMDisk (A:/) is read-only.\n");
        return 0;
    }

    PU8 rel_path = resolved;
    if (strncmp(resolved, m->mount_path, strlen(m->mount_path)) == 0) {
        rel_path = resolved + strlen(m->mount_path);
    } else if (strncmp(resolved, m->dev_name, strlen(m->dev_name)) == 0) {
        rel_path = resolved + strlen(m->dev_name);
        if (*rel_path == ':') rel_path = rel_path + 1;
    }
    while (*rel_path == '/') rel_path = rel_path + 1;

    U8 filename[64];
    U32 dir_cluster = vfs_get_parent_dir_cluster(&m->fat32_vol, rel_path, filename);
    if (dir_cluster == 0) return 0;

    return fat32_remove_entry(&m->fat32_vol, dir_cluster, filename);
}

U0 vfs_list_drives() {
    shell_puts((PU8)"=== Block Devices & Filesystem Mounts ===\n");
    shell_printf("  Device: %s  Type: %s  FS: %s  MountPoint: %s\n", "ram0", "RAMDisk", "FAT12", "A:/");
    shell_printf("  Device: %s  Type: %s  FS: %s  MountPoint: %s\n", "hd0", "ATA HDD", "MBR", "/hd0");

    for (U32 i = 0; i < VFS_MAX_MOUNTS; i = i + 1) {
        if (g_vfs_mounts[i].used) {
            PU8 fs_str = (PU8)"Unknown";
            if (g_vfs_mounts[i].fs_type == VFS_FS_FAT12) fs_str = (PU8)"FAT12";
            if (g_vfs_mounts[i].fs_type == VFS_FS_FAT32) fs_str = (PU8)"FAT32";

            shell_printf("  Device: %s  Type: %s  FS: %s  MountPoint: %s\n",
                       g_vfs_mounts[i].dev_name, "Partition", fs_str, g_vfs_mounts[i].mount_path);
        }
    }
}
