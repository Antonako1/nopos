#include "kernel.ah"
#include "BUILDNUM.AH"
U0 _start(KERNEL_TABLE *kt) {
    asm { CLI }

    GDT_INIT();
    IDT_INIT();
    ISR_INIT();
    PIC_REMAP();
    IRQ_INIT();

    pit_init();
    ps2_init();

    serial_ports_init();
    gkt = kt;
    dcominit();
    SVGA_CLEAR_SCREEN(BLACK);

    dcom_yl_on();
    dcom_rl_on();
    dcom_gl_on();
    dcomprintf("nopos starting, build number %d, %x, %d", BUILDNUM, 0xFF, -11);

    // Memory Management Initialization
    e820_dump(gkt->e820entries, gkt->e820cnt);
    panic_if(pg_init() == FALSE, "Failed to initialize pageframe", PANIC_KERNEL, 0);
    pf_dump();
    dcomprintf("[MM] Pageframe initialized successfully.");
    panic_if(paging_init() == FALSE, "Failed to initialize paging", PANIC_KERNEL, 0);
    dcomprintf("[MM] Paging initialized successfully.");
    panic_if(heap_init(0) == FALSE, "Failed to initialize heap", PANIC_KERNEL, 0);
    dcomprintf("[MM] Heap initialized successfully.");

    // Storage & VFS Initialization
    ata_init();
    dcomputs("[ATA] ATA Controller initialized successfully.");
    vfs_init();
    dcomputs("[VFS] Virtual File System initialized successfully.");

    dcomprintf("[BOOT] BootDrive=0x%02X, BootType=%d, RAMBase=0x%08X, RAMSize=%d\n",
               gkt->boot_drive, gkt->boot_type, gkt->ramdisk_base, gkt->ramdisk_size);

    if (gkt->boot_type == 1 && gkt->ramdisk_base != 0) {
        PU8 base = (PU8)gkt->ramdisk_base;
        U32 size = gkt->ramdisk_size;
        ramdisk_init(base, size);
        vfs_mount("ram0", "A:/", VFS_FS_FAT12);
        dcomputs("[FS] Mounted FAT12 RAMDisk to A:/");
        strcpy(g_sh_cwd, "A:/");
    }

    MBR_PARTITION_ENTRY fat32_part;
    if (mbr_find_fat32(0, &fat32_part)) {
        dcomprintf("[FS] Found FAT32 partition on hd0: LBA=%d, Sectors=%d\n", fat32_part.start_lba, fat32_part.sector_count);
        vfs_mount("hd0p1", "C:/", VFS_FS_FAT32);
        if (gkt->boot_type != 1) {
            strcpy(g_sh_cwd, "C:/");
        }
    }
    dcomputs("[FS] VFS Storage & Mounts initialized successfully.");

    pci_initialize();
    dcomputs("[PCI] PCI Bus initialized successfully.");
    asm { STI }

    dcom_rl_off();
    dcom_yl_off();
    dcom_gl_on();

    dcomprintf("[SHELL] Starting shell...");
    SHELL_RUN();

    asm { 
        CLI    
        HLT 
    }
}
