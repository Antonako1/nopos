#include "kernel.ah"
KERNEL_TABLE *gkt;

U0 _start(KERNEL_TABLE *kt) {
    asm { CLI }

    GDT_INIT();
    IDT_INIT();
    ISR_INIT();
    PIC_REMAP();
    IRQ_INIT();

    pit_init();
    ps2_init();

    serial_ports_init();
    gkt = kt;

    SVGA_DRAW_TEST();    
    asm { STI }
    while (1) {
        U8 c = ps2_getc();
        SVGA_DRAW_CHARACTER(256,256,c,WHITE,BLUE);
    }
    asm { 
        CLI    
        HLT 
    }
}
