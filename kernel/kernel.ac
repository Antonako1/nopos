#include "kernel.ah"
KERNEL_TABLE *gkt;

U0 _start(KERNEL_TABLE *kt) {
    asm { CLI }

    GDT_INIT();
    IDT_INIT();
    ISR_INIT();
    PIC_REMAP();
    IRQ_INIT();

    serial_ports_init();
    gkt = kt;

    SVGA_DRAW_TEST();    
    
    while (1) {
        asm { 
            CLI    
            HLT 
        }
    }
}

