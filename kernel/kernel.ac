#include "kernel.ah"
KERNEL_TABLE *gkt;

U0 _start(KERNEL_TABLE *kt) {
    asm { CLI }

    GDT_INIT();
    IDT_INIT();
    ISR_INIT();
    PIC_REMAP();
    IRQ_INIT();

    pit_init();
    ps2_init();

    serial_ports_init();
    gkt = kt;
    dcominit();
    SVGA_CLEAR_SCREEN(BLACK);
    SVGA_DRAW_TEST();
    
    dcom_yl_on();
    dcom_rl_on();
    dcom_gl_on();
    dcom_rl_off();
    dcom_yl_off();
    dcom_gl_off();
    dcomputs("nopos dcomputs() test");


    // panic_if(pg_init() == FALSE, "Failed to initialized pageframe", PANIC_KERNEL, 0);
    // panic_if(heap_init(1) == FALSE, "Failed to initialized heap", PANIC_KERNEL, 0);


    asm { STI }

    dcom_rl_off();
    dcom_yl_off();
    dcom_gl_on();
    
    SHELL_RUN();

    asm { 
        CLI    
        HLT 
    }
}
