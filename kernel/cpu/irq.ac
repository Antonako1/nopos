U0 PIC_REMAP()
{
    asm {
        MOV AL, 0x11
        DB 0xE6, 0x20
        DB 0xE6, 0xA0
        MOV AL, 0x20
        DB 0xE6, 0x21
        MOV AL, 0x28
        DB 0xE6, 0xA1
        MOV AL, 0x04
        DB 0xE6, 0x21
        MOV AL, 0x02
        DB 0xE6, 0xA1
        MOV AL, 0x01
        DB 0xE6, 0x21
        DB 0xE6, 0xA1
    }
}

#define PIC1_COMMAND_PORT 0x20
#define PIC1_DATA_PORT 0x21
#define PIC2_COMMAND_PORT 0xA0
#define PIC2_DATA_PORT 0xA1
#define PIC_EOI 0x20

#define PIC_REMAP_OFFSET 0x20
#define PIC_REMAP_OFFSET2 0x28
#define PIC_REMAP_END     0x30

U0 IRQ_INIT()
{
    idt_set_gate(32, (U32)&irq32, KCODE_SEL, INT_GATE_32);
    idt_set_gate(33, (U32)&irq33, KCODE_SEL, INT_GATE_32);
    idt_set_gate(34, (U32)&irq34, KCODE_SEL, INT_GATE_32);
